{
  "rewrites": [
    {
      "source": "/",
      "destination": "/portfolio.html"
    },
    {
      "source": "/about",
      "destination": "/portfolio.html"
    },
    {
      "source": "/work",
      "destination": "/portfolio.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/portfolio.html"
    }
  ]
}
